-- -------- God Mode (Combat tab) --------
local godConnection
local savedMaxHealth = nil
local function enableGod()
    state.god = true
    local hum = getHum()
    if hum then
        savedMaxHealth = hum.MaxHealth
        hum.MaxHealth = 1e9
        hum.Health = hum.MaxHealth
    end
    if godConnection and godConnection.Connected then godConnection:Disconnect() end
    godConnection = RunService.Heartbeat:Connect(function()
        local hum = getHum()
        if hum and state.god then
            hum.Health = hum.MaxHealth
        end
    end)
end
local function disableGod()
    state.god = false
    if godConnection then godConnection:Disconnect(); godConnection = nil end
    local hum = getHum()
    if hum and savedMaxHealth then
        hum.MaxHealth = savedMaxHealth
        hum.Health = math.min(hum.Health, savedMaxHealth)
    end
    savedMaxHealth = nil
end

-- -------- Infinite Jump (Movement) --------
local function onJumpRequest()
    if state.infjump then
        local hum = getHum()
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            -- neon plate under player
            local hrp = getHRP()
            if hrp then
                local plate = Instance.new("Part", workspace)
                plate.Anchored = true
                plate.CanCollide = false
                plate.Size = Vector3.new(6,1,6)
                plate.Material = Enum.Material.Neon
                plate.Color = Color3.fromHSV((tick()%5)/5,1,1)
                plate.CFrame = hrp.CFrame * CFrame.new(0,-4,0)
                Debris:AddItem(plate, 0.55)
            end
        end
    end
end
UserInputService.JumpRequest:Connect(onJumpRequest)

-- -------- Fly (Movement) --------
local flyConn
local flyBV, flyBG
local flySpeed = 60
local function enableFly()
    if state.fly then return end
    state.fly = true
    local char = getChar()
    if not char then return end
    local hrp = getHRP()
    if not hrp then return end
    flyBV = Instance.new("BodyVelocity", hrp)
    flyBV.MaxForce = Vector3.new(0,0,0) -- will set each tick
    flyBV.Velocity = Vector3.new(0,0,0)
    flyBG = Instance.new("BodyGyro", hrp)
    flyBG.MaxTorque = Vector3.new(0,0,0)
    flyBG.CFrame = workspace.CurrentCamera.CFrame

    flyConn = RunService.RenderStepped:Connect(function(dt)
        if not state.fly then return end
        if not hrp or not getHum() then return end
        local cam = workspace.CurrentCamera
        local moveDir = getHum().MoveDirection -- works on mobile joystick and keyboard
        -- move relative to camera
        local worldMove = (cam.CFrame:VectorToWorldSpace(moveDir))
        local vy = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vy = vy + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vy = vy - 1 end
        local final = (worldMove * flySpeed) + Vector3.new(0, vy * (flySpeed*0.7), 0)
        flyBV.MaxForce = Vector3.new(9e5,9e5,9e5)
        flyBV.Velocity = final
        flyBG.MaxTorque = Vector3.new(9e5,9e5,9e5)
        flyBG.CFrame = cam.CFrame
    end)
end

local function disableFly()
    state.fly = false
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
end


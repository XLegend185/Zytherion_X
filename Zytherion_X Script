-- apply speed
local speedConnection
local function enableSpeed()
    state.speed = true
    speedIndicator.BackgroundColor3 = Color3.fromRGB(0,200,80)
    -- set immediately
    local hum = getHum()
    if hum then hum.WalkSpeed = state.desiredSpeed end
    if speedConnection then speedConnection:Disconnect() end
    speedConnection = RunService.Heartbeat:Connect(function()
        local hum = getHum()
        if hum and state.speed then hum.WalkSpeed = state.desiredSpeed end
    end)
    -- trail + particles
    local char = getChar()
    if char and not char:FindFirstChild("ZytherionTrail") then
        local hrp = getHRP()
        if hrp then
            local a0 = Instance.new("Attachment", hrp); a0.Name = "ZyA0"; a0.Position = Vector3.new(0,1,0)
            local a1 = Instance.new("Attachment", hrp); a1.Name = "ZyA1"; a1.Position = Vector3.new(0,-1,0)
            local trail = Instance.new("Trail", hrp); trail.Name = "ZytherionTrail"; trail.Attachment0 = a0; trail.Attachment1 = a1; trail.Lifetime = 0.35; trail.MinLength = 0.05
            -- animate colors
            spawn(function()
                while trail.Parent and state.speed do
                    for v=0,1,0.02 do
                        trail.Color = ColorSequence.new(Color3.fromHSV(v,1,1))
                        task.wait(0.03)
                    end
                end
            end)
            local p = Instance.new("ParticleEmitter", hrp)
            p.Name = "ZytherionParticles"
            p.Texture = "rbxassetid://241594314"
            p.Rate = 60
            p.Lifetime = NumberRange.new(0.25)
            p.Speed = NumberRange.new(0)
            p.Size = NumberSequence.new(0.6)
        end
    end
end

local function disableSpeed()
    state.speed = false
    speedIndicator.BackgroundColor3 = Color3.fromRGB(200,50,50)
    if speedConnection then speedConnection:Disconnect(); speedConnection = nil end
    local hum = getHum()
    if hum then hum.WalkSpeed = state.defaultSpeed end
    local char = getChar()
    if char then
        -- cleanup trail/attachments/particles
        local hrp = getHRP()
        if hrp then
            if hrp:FindFirstChild("ZytherionTrail") then hrp.ZytherionTrail:Destroy() end
            if hrp:FindFirstChild("ZyA0") then hrp.ZyA0:Destroy() end
            if hrp:FindFirstChild("ZyA1") then hrp.ZyA1:Destroy() end
            if hrp:FindFirstChild("ZytherionParticles") then hrp.ZytherionParticles:Destroy() end
        end
    end
end


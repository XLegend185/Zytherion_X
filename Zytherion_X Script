local espGuis = {} -- map player -> billboard
local function createESPForPlayer(plr)
    if not plr or plr == LocalPlayer then return end
    if espGuis[plr] and espGuis[plr].Parent then return end
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return end

    local bill = Instance.new("BillboardGui")
    bill.Name = "ZytherionESP"
    bill.Adornee = head
    bill.Size = UDim2.new(4,0,2.2,0)
    bill.AlwaysOnTop = true
    bill.Parent = head

    local bg = Instance.new("Frame", bill)
    bg.Size = UDim2.new(1,0,1,0)
    bg.Position = UDim2.new(0,0,0,0)
    bg.BackgroundColor3 = Color3.fromRGB(12,12,16)
    bg.BackgroundTransparency = 0.45
    bg.BorderSizePixel = 0
    local bgCorner = Instance.new("UICorner", bg); bgCorner.CornerRadius = UDim.new(0,8)

    local nameLabel = Instance.new("TextLabel", bill)
    nameLabel.Size = UDim2.new(1,0,0,28)
    nameLabel.Position = UDim2.new(0,-0, -0.15)
    nameLabel.Text = plr.Name
    nameLabel.TextColor3 = Color3.fromRGB(120,255,140)
    nameLabel.Font = Enum.Font.Arcade
    nameLabel.TextSize = 20
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextStrokeTransparency = 0.6

    -- small indicator circle (team color or white)
    local indicator = Instance.new("Frame", bill)
    indicator.Size = UDim2.new(0,10,0,10)
    indicator.Position = UDim2.new(0.92, 0, 0.02, 0)
    indicator.BackgroundColor3 = (plr.Team and plr.Team.TeamColor and Color3.fromRGB(plr.Team.TeamColor.R * 255, plr.Team.TeamColor.G * 255, plr.Team.TeamColor.B * 255)) or Color3.fromRGB(200,200,200)
    indicator.BorderSizePixel = 0
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1,0)

    espGuis[plr] = bill

    -- cleanup on removing
    plr.CharacterRemoving:Connect(function()
        if espGuis[plr] and espGuis[plr].Parent then
            espGuis[plr]:Destroy()
        end
        espGuis[plr] = nil
    end)
end

local function enableESP()
    -- create for all existing players with characters
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            createESPForPlayer(p)
        end
    end
    -- connect new players/characters
    if not state._espCon then
        state._espCon = Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(function()
                if state.esp then
                    createESPForPlayer(p)
                end
            end)
        end)
    end
end

local function disableESP()
    for p,bill in pairs(espGuis) do
        if bill and bill.Parent then
            bill:Destroy()
        end
    end
    espGuis = {}
    if state._espCon then state._espCon:Disconnect(); state._espCon = nil end
end

